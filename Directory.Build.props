<Project>
  <!--
    PIX API discovery (adapted from microsoft/pix-samples api/Directory.Build.props).

    PixInstallDir resolves from, in order:
      1. /p:PixInstallDir=<path>
      2. the PIX_DIR environment variable
      3. the newest %ProgramFiles%\Microsoft PIX Preview\<version> whose YYMM.DD date is after 2606.15

    Expected layout under PixInstallDir: include\PixApi.h, lib\PixApi.lib, pixapi.dll, PixApiCsExt.experimental.dll
  -->
  <PropertyGroup>
    <PixInstallDir Condition="'$(PixInstallDir)' == ''">$(PIX_DIR)</PixInstallDir>
    <_PixProgramFiles Condition="'$(_PixProgramFiles)' == ''">$(ProgramW6432)</_PixProgramFiles>
    <_PixProgramFiles Condition="'$(_PixProgramFiles)' == ''">$(ProgramFiles)</_PixProgramFiles>
    <_PixProgramFiles Condition="'$(_PixProgramFiles)' == ''">C:\Program Files</_PixProgramFiles>
    <_PixPreviewMinDate>2606.15</_PixPreviewMinDate>
    <PixApiBinDir>$(PixInstallDir)</PixApiBinDir>
  </PropertyGroup>

  <UsingTask TaskName="FindPixPreviewInstall" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <PreviewRoot ParameterType="System.String" Required="true" />
      <MinimumDate ParameterType="System.String" Required="true" />
      <InstallDir ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Globalization" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        int[] ParseVersion(string leaf)
        {
            string[] parts = leaf.Split(new[] { '-' }, 2)[0].Split('.');
            if (parts.Length < 2) return null;
            var version = new int[parts.Length];
            for (int i = 0; i < parts.Length; i++)
            {
                if (!int.TryParse(parts[i], NumberStyles.None, CultureInfo.InvariantCulture, out version[i]))
                    return null;
            }
            return version;
        }

        int CompareVersions(int[] left, int[] right)
        {
            for (int i = 0; i < Math.Max(left.Length, right.Length); i++)
            {
                int a = i < left.Length ? left[i] : 0;
                int b = i < right.Length ? right[i] : 0;
                if (a != b) return a.CompareTo(b);
            }
            return 0;
        }

        InstallDir = string.Empty;
        int[] newest = null;
        int[] minimum = ParseVersion(MinimumDate);
        if (Directory.Exists(PreviewRoot))
        {
            foreach (string directory in Directory.EnumerateDirectories(PreviewRoot))
            {
                if (!File.Exists(Path.Combine(directory, "PixApiCsExt.experimental.dll"))) continue;
                int[] version = ParseVersion(Path.GetFileName(directory));
                if (version == null || CompareVersions(new[] { version[0], version[1] }, minimum) <= 0) continue;
                int comparison = newest == null ? 1 : CompareVersions(version, newest);
                if (comparison > 0 || (comparison == 0 && StringComparer.OrdinalIgnoreCase.Compare(directory, InstallDir) > 0))
                {
                    newest = version;
                    InstallDir = Path.GetFullPath(directory);
                }
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ValidatePixInstallDir" BeforeTargets="PrepareForBuild" Condition="'$(PixMcpRequiresPix)' == 'true'">
    <FindPixPreviewInstall Condition="'$(PixInstallDir)' == ''"
                           PreviewRoot="$(_PixProgramFiles)\Microsoft PIX Preview" MinimumDate="$(_PixPreviewMinDate)">
      <Output TaskParameter="InstallDir" PropertyName="_PixDiscoveredInstallDir" />
    </FindPixPreviewInstall>
    <PropertyGroup>
      <PixInstallDir Condition="'$(PixInstallDir)' == ''">$(_PixDiscoveredInstallDir)</PixInstallDir>
      <PixApiBinDir>$(PixInstallDir)</PixApiBinDir>
    </PropertyGroup>
    <Error Condition="'$(PixInstallDir)' == ''"
           Text="No usable PIX installation found. Install a PIX Preview build newer than $(_PixPreviewMinDate) (under %ProgramFiles%\Microsoft PIX Preview\&lt;version&gt;\), or set PIX_DIR / pass /p:PixInstallDir=&lt;path&gt;." />
    <Error Condition="!Exists('$(PixInstallDir)\PixApiCsExt.experimental.dll')"
           Text="PIX installation at '$(PixInstallDir)' does not contain PixApiCsExt.experimental.dll." />

    <!-- References were evaluated before automatic discovery. Refresh their metadata before
         PrepareForBuild, which ResolveAssemblyReferences also depends on. -->
    <ItemGroup>
      <Reference Condition="'%(Reference.Identity)' == 'PixApiCsExt.experimental'">
        <HintPath>$(PixApiBinDir)\PixApiCsExt.experimental.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
