[
 ["pix_info", {"probe": true}, {"pix.apiLoaded": true}],
 ["pix_device_connect", {}],
 ["pix_device_launch", {"handle": "$pix_device_connect.handle", "exePath": "tests/D3D12TestApp/bin/D3D12TestApp.exe", "arguments": "--frames 1500 --hidden"}],
 ["pix_device_take_gpu_capture", {"handle": "$pix_device_connect.handle", "processId": "$pix_device_launch.processId", "delaySeconds": 4, "waitSeconds": 120}, {"status": "succeeded"}],
 ["pix_result_read", {"resultRef": "$pix_device_take_gpu_capture.resultRef", "pointer": "/gpuCapture"}],
 ["pix_gpu_info", {"handle": "$pix_result_read.value.handle"}],
 ["pix_device_detach", {"handle": "$pix_device_connect.handle", "terminate": true}],
 ["pix_gpu_queues", {"handle": "$pix_gpu_info.handle"}],
 ["pix_gpu_events", {"handle": "$pix_gpu_info.handle", "kind": "draw", "limit": 5}, {"total": 3}],
 ["pix_gpu_screenshot", {"handle": "$pix_gpu_info.handle"}],
 ["pix_gpu_analysis_start", {"handle": "$pix_gpu_info.handle", "waitSeconds": 300}, {"status": "succeeded"}],
 ["pix_gpu_timing_events", {"handle": "$pix_gpu_info.handle", "limit": 5}],
 ["pix_gpu_pipeline_state", {"eventRef": "$pix_gpu_events.items.0.eventRef"}],
 ["pix_gpu_shader_code", {"shaderRef": "$pix_gpu_pipeline_state.shaders.0.shaderRef", "lineCount": 50}],
 ["pix_gpu_event_resources", {"eventRef": "$pix_gpu_events.items.0.eventRef"}],
 ["pix_gpu_counters_list", {"handle": "$pix_gpu_info.handle"}],
 ["pix_gpu_counters_prepare", {"handle": "$pix_gpu_info.handle", "counterIds": ["$pix_gpu_counters_list.items.0.id"], "waitSeconds": 300}, {"status": "succeeded"}],
 ["pix_gpu_counters_read", {"handle": "$pix_gpu_info.handle", "counterIds": ["$pix_gpu_counters_list.items.0.id"], "limit": 5}],
 ["pix_gpu_drpix_experiments", {"handle": "$pix_gpu_info.handle"}],
 ["pix_gpu_drpix_run", {"handle": "$pix_gpu_info.handle", "experiments": ["1x1 Viewport"], "wholeCapture": true, "waitSeconds": 300}, {"status": "succeeded"}],
 ["pix_close_all", {}]
]
