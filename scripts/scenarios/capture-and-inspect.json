[
 ["pix_info", {"probe": true}, {"pix.apiLoaded": true}],
 ["pix_device_connect", {}],
 ["pix_device_launch", {"handle": "$pix_device_connect.handle", "exePath": "tests/D3D12TestApp/bin/D3D12TestApp.exe", "arguments": "--frames 1500"}],
 ["pix_device_take_gpu_capture", {"handle": "$pix_device_connect.handle", "processId": "$pix_device_launch.processId", "delaySeconds": 4, "waitSeconds": 120}, {"status": "succeeded"}],
 ["pix_device_detach", {"handle": "$pix_device_connect.handle", "terminate": true}],
 ["pix_gpu_queues", {"handle": "$pix_device_take_gpu_capture.result.gpuCapture.handle"}],
 ["pix_gpu_events", {"handle": "$pix_device_take_gpu_capture.result.gpuCapture.handle", "kind": "draw", "limit": 5}, {"total": 3}],
 ["pix_gpu_screenshot", {"handle": "$pix_device_take_gpu_capture.result.gpuCapture.handle"}],
 ["pix_gpu_analysis_start", {"handle": "$pix_device_take_gpu_capture.result.gpuCapture.handle", "waitSeconds": 300}, {"status": "succeeded"}],
 ["pix_gpu_timing_events", {"handle": "$pix_device_take_gpu_capture.result.gpuCapture.handle", "limit": 5}],
 ["pix_gpu_pipeline_state", {"handle": "$pix_device_take_gpu_capture.result.gpuCapture.handle", "queueIndex": "$pix_gpu_events.items.0.queueIndex", "eventIndex": "$pix_gpu_events.items.0.index"}],
 ["pix_gpu_shader_code", {"handle": "$pix_device_take_gpu_capture.result.gpuCapture.handle", "queueIndex": "$pix_gpu_events.items.0.queueIndex", "eventIndex": "$pix_gpu_events.items.0.index", "shaderIndex": 0, "maxChars": 2000}],
 ["pix_gpu_event_resources", {"handle": "$pix_device_take_gpu_capture.result.gpuCapture.handle", "queueIndex": "$pix_gpu_events.items.0.queueIndex", "eventIndex": "$pix_gpu_events.items.0.index"}],
 ["pix_gpu_counters_list", {"handle": "$pix_device_take_gpu_capture.result.gpuCapture.handle"}],
 ["pix_gpu_counters_start", {"handle": "$pix_device_take_gpu_capture.result.gpuCapture.handle", "counterIds": ["$pix_gpu_counters_list.items.0.id"], "waitSeconds": 300}, {"status": "succeeded"}],
 ["pix_gpu_counters_collect", {"handle": "$pix_device_take_gpu_capture.result.gpuCapture.handle", "counterIds": ["$pix_gpu_counters_list.items.0.id"], "limit": 5}],
 ["pix_gpu_drpix_experiments", {"handle": "$pix_device_take_gpu_capture.result.gpuCapture.handle"}],
 ["pix_gpu_drpix_run", {"handle": "$pix_device_take_gpu_capture.result.gpuCapture.handle", "experiments": ["1x1 Viewport"], "waitSeconds": 300}, {"status": "succeeded"}],
 ["pix_close_all", {}]
]
