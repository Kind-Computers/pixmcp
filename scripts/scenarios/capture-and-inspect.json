[
 ["pix_info", {"probe": true}],
 ["pix_device_connect", {}],
 ["pix_device_launch", {"handle": "device-1", "exePath": "tests/D3D12TestApp/bin/D3D12TestApp.exe", "arguments": "--frames 1500"}],
 ["pix_device_take_gpu_capture", {"handle": "device-1", "processId": "$pix_device_launch.processId", "delaySeconds": 4, "waitSeconds": 120}],
 ["pix_device_detach", {"handle": "device-1", "terminate": true}],
 ["pix_gpu_queues", {"handle": "gpu-1"}],
 ["pix_gpu_events", {"handle": "gpu-1", "kind": "draw", "limit": 5}],
 ["pix_gpu_screenshot", {"handle": "gpu-1"}],
 ["pix_gpu_analysis_start", {"handle": "gpu-1", "waitSeconds": 300}],
 ["pix_gpu_timing_events", {"handle": "gpu-1", "limit": 5}],
 ["pix_gpu_pipeline_state", {"handle": "gpu-1", "queueIndex": 0, "eventIndex": "$pix_gpu_events.items.0.index"}],
 ["pix_gpu_shader_code", {"handle": "gpu-1", "queueIndex": 0, "eventIndex": "$pix_gpu_events.items.0.index", "shaderIndex": 0, "maxChars": 2000}],
 ["pix_gpu_event_resources", {"handle": "gpu-1", "queueIndex": 0, "eventIndex": "$pix_gpu_events.items.0.index"}],
 ["pix_gpu_counters_list", {"handle": "gpu-1"}],
 ["pix_gpu_drpix_experiments", {"handle": "gpu-1"}],
 ["pix_gpu_drpix_run", {"handle": "gpu-1", "experiments": ["1x1 Viewport"], "waitSeconds": 300}],
 ["pix_close_all", {}]
]
