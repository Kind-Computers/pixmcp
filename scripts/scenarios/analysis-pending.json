[
 ["pix_gpu_open", {"path": "$env.PIX_TEST_CAPTURE"}],
 ["pix_gpu_events", {"handle": "$pix_gpu_open.handle", "kind": "draw", "limit": 1}],
 ["pix_gpu_pipeline_state", {"handle": "$pix_gpu_open.handle", "queueIndex": "$pix_gpu_events.items.0.queueIndex", "eventIndex": "$pix_gpu_events.items.0.index", "waitSeconds": 0}, {"pending": true, "retry": "pix_gpu_pipeline_state", "job.kind": "analysis"}],
 ["pix_info", {}, {"worker.runningJob": "$last.jobId"}],
 ["pix_job_wait", {"jobId": "$pix_gpu_pipeline_state.jobId", "timeoutSeconds": 300}, {"status": "succeeded", "result.prepared": "analysis"}],
 ["pix_gpu_pipeline_state", {"handle": "$pix_gpu_open.handle", "queueIndex": "$pix_gpu_events.items.0.queueIndex", "eventIndex": "$pix_gpu_events.items.0.index"}, {"programType": "GENERIC_PIPELINE"}],
 ["pix_gpu_shader_code", {"handle": "$pix_gpu_open.handle", "queueIndex": "$pix_gpu_events.items.0.queueIndex", "eventIndex": "$pix_gpu_events.items.0.index", "shaderIndex": 0, "maxChars": 500}, {"codeType": "HLSL", "shader.index": 0}],
 ["pix_gpu_analysis_start", {"handle": "$pix_gpu_open.handle", "waitSeconds": 60}, {"status": "succeeded", "result.alreadyStarted": true}],
 ["pix_gpu_timing_events", {"handle": "$pix_gpu_open.handle", "limit": 3, "waitSeconds": 0}, {"pending": true, "job.kind": "timing"}],
 ["pix_job_wait", {"jobId": "$last.jobId", "timeoutSeconds": 300}, {"status": "succeeded"}],
 ["pix_gpu_timing_events", {"handle": "$pix_gpu_open.handle", "kind": "draw", "limit": 3}, {"total": 3}],
 ["pix_gpu_timing_collect", {"handle": "$pix_gpu_open.handle", "waitSeconds": 60}, {"status": "succeeded"}],
 ["pix_gpu_timing_tree", {"handle": "$pix_gpu_open.handle", "queueIndex": 0, "depth": 2, "limit": 5}, {"queueIndex": 0}],
 ["pix_gpu_event", {"handle": "$pix_gpu_open.handle", "gpuId": "$pix_gpu_events.items.0.gpuId"}, {"event.index": "$pix_gpu_events.items.0.index"}],
 ["pix_gpu_counters_list", {"handle": "$pix_gpu_open.handle"}],
 ["pix_gpu_counters_collect", {"handle": "$pix_gpu_open.handle", "counterIds": ["$pix_gpu_counters_list.items.0.id"], "limit": 3, "waitSeconds": 120}, {"offset": 0}],
 ["pix_jobs", {}],
 ["pix_close_all", {}]
]
