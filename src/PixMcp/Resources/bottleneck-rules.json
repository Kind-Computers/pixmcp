{
  "$comment": "Heuristic limiter rules for pix_gpu_bottleneck. metric is a case-insensitive regular expression over evidence metric names of the same source; a secondary condition must also hold. Satisfied weights combine per limiter as 1 - product(1 - weight). validated records which vendor blocks were checked on hardware with a known limiter; none is yet, so confidence stays below high.",
  "version": 1,
  "validated": { "intel": false, "nvidia": false, "amd": false },
  "rules": [
    { "id": "drpix_1x1_dominant", "vendor": "any", "source": "drpix", "metric": "^drpix\\.1x1 Viewport\\.savedPercent$", "op": "gt", "threshold": 60, "limiter": "pixelShading", "weight": 0.8, "note": "A 1x1 viewport removes most of the scope's time, so per-pixel work dominates." },
    { "id": "drpix_1x1_significant", "vendor": "any", "source": "drpix", "metric": "^drpix\\.1x1 Viewport\\.savedPercent$", "op": "gt", "threshold": 30, "limiter": "pixelShading", "weight": 0.4, "note": "A 1x1 viewport saves a large share of the scope's time." },
    { "id": "drpix_msaa", "vendor": "any", "source": "drpix", "metric": "^drpix\\..*MSAA.*\\.savedPercent$", "op": "gt", "threshold": 25, "limiter": "rasterOrDepth", "weight": 0.4, "note": "Disabling MSAA saves a large share of the scope's time." },
    { "id": "drpix_early_z", "vendor": "any", "source": "drpix", "metric": "^drpix\\.Force ?Early ?Z\\.savedPercent$", "op": "gt", "threshold": 20, "limiter": "rasterOrDepth", "weight": 0.6, "note": "Forcing early depth testing saves time, so late depth testing wastes pixel work." },
    { "id": "drpix_quad_efficiency_low", "vendor": "any", "source": "drpix", "metric": "^drpix\\.quadEfficiencyPercent$", "op": "lt", "threshold": 75, "limiter": "rasterOrDepth", "weight": 0.5, "note": "Many 2x2 quads cover fewer than four pixels: tiny triangles waste rasterization and pixel shading." },
    { "id": "depth_rejected_high", "vendor": "any", "source": "counters", "metric": "^counters\\.depthRejectedPercent$", "op": "gt", "threshold": 50, "limiter": "rasterOrDepth", "weight": 0.4, "note": "Most submitted samples fail the depth test after being rasterized." },
    { "id": "few_pixels_per_primitive", "vendor": "any", "source": "counters", "metric": "^counters\\.psInvocationsPerPrimitive$", "op": "lt", "threshold": 2, "limiter": "vertexOrGeometry", "weight": 0.4, "note": "Primitives cover under two pixels on average, so vertex and setup work outweighs shading." },
    { "id": "intel_ps_alu", "vendor": "intel", "source": "counters", "metric": "^XVE_INST_EXECUTED_ALU0_PS_UTILIZATION$", "op": "gt", "threshold": 60, "secondary": { "source": "counters", "metric": "^XVE_INST_EXECUTED_ALU0_VS_UTILIZATION$", "op": "lt", "threshold": 20 }, "limiter": "pixelShading", "weight": 0.5, "note": "Pixel shader ALU utilization is high while vertex shader utilization is low." },
    { "id": "intel_vs_alu", "vendor": "intel", "source": "counters", "metric": "^XVE_INST_EXECUTED_ALU0_VS_UTILIZATION$", "op": "gt", "threshold": 60, "secondary": { "source": "counters", "metric": "^XVE_INST_EXECUTED_ALU0_PS_UTILIZATION$", "op": "lt", "threshold": 20 }, "limiter": "vertexOrGeometry", "weight": 0.5, "note": "Vertex shader ALU utilization is high while pixel shader utilization is low." },
    { "id": "intel_early_depth", "vendor": "intel", "source": "counters", "metric": "^(EarlyDepthBottleneck|Z Utilization \\(%\\))$", "op": "gt", "threshold": 70, "limiter": "rasterOrDepth", "weight": 0.5, "note": "The depth unit is saturated." },
    { "id": "intel_memory_bandwidth", "vendor": "intel", "source": "counters", "metric": "^GPU Memory Utilization \\(%\\)$", "op": "gt", "threshold": 70, "secondary": { "source": "counters", "metric": "^XVE Utilization \\(%\\)$", "op": "lt", "threshold": 40 }, "limiter": "memoryBandwidth", "weight": 0.7, "note": "Memory utilization is high while execution units are underused." },
    { "id": "cache_hit_low", "vendor": "any", "source": "counters", "metric": "cache.*hit", "op": "lt", "threshold": 50, "limiter": "cacheMiss", "weight": 0.5, "note": "Cache hit rates are low." },
    { "id": "intel_occupancy_stalls", "vendor": "intel", "source": "occupancy", "metric": "^occupancy\\.averagePercent$", "op": "lt", "threshold": 30, "secondary": { "source": "counters", "metric": "^XVE_STALL$", "op": "gt", "threshold": 50 }, "limiter": "occupancyLatency", "weight": 0.7, "note": "Execution slots are mostly empty while shader threads stall." },
    { "id": "occupancy_low", "vendor": "any", "source": "occupancy", "metric": "^occupancy\\.averagePercent$", "op": "lt", "threshold": 30, "limiter": "occupancyLatency", "weight": 0.3, "note": "Execution slots are mostly empty over the scope window." },
    { "id": "small_dispatch_launch", "vendor": "any", "source": "timing", "metric": "^timing\\.smallDispatchEopPercent$", "op": "gt", "threshold": 50, "secondary": { "source": "timing", "metric": "^timing\\.smallDispatchExecToEop$", "op": "gt", "threshold": 2 }, "limiter": "launchOverhead", "weight": 0.6, "note": "Most dispatch time is in small dispatches whose submission-to-completion time far exceeds their execution." },
    { "id": "pending_before_execution", "vendor": "any", "source": "timing", "metric": "^timing\\.eopShareOfExecPercent$", "op": "lt", "threshold": 25, "limiter": "syncIdle", "weight": 0.3, "note": "Work spends most of its TOP-to-EOP time waiting before execution; normal pipelining can also cause this." },
    { "id": "idle_in_scope", "vendor": "any", "source": "timing", "metric": "^timing\\.idlePercent$", "op": "gt", "threshold": 30, "limiter": "syncIdle", "weight": 0.7, "note": "The queue is idle for a large share of the scope window." },
    { "id": "nvidia_alu_pipe", "vendor": "nvidia", "source": "counters", "metric": "^ALU Pipe Activity ?\\(%\\)$", "op": "gt", "threshold": 70, "limiter": "pixelShading", "weight": 0.4, "note": "ALU pipe activity is high." },
    { "id": "nvidia_unused_warp_slots", "vendor": "nvidia", "source": "counters", "metric": "^Active SM Unused Warp Slots ?\\(%\\)$", "op": "gt", "threshold": 50, "limiter": "occupancyLatency", "weight": 0.4, "note": "Many streaming multiprocessor slots are unused." }
  ]
}
