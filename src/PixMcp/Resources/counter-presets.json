{
  "$comment": "Named counter groups. Patterns are case-insensitive globs over counter names. confidence: verified (seen on hardware through this server), transcribed (from vendor plugin strings or docs, not run here), unverified (best guess). Intel names come from the PPI-imdp.dll 2601.15+ plugin strings; NVIDIA D3D pipeline statistics were verified on an RTX 4070 Ti (PIX 2606.18-preview exposes only the D3D counters there); AMD names are GPA-style guesses.",
  "presets": {
    "utilization": {
      "description": "Top-level busy/utilization lanes: which unit is saturated.",
      "vendors": {
        "intel": { "confidence": "transcribed", "patterns": ["Xe GPU Utilization", "XVE Utilization (%)", "Sampler Utilization (%)", "Rasterizer Utilization (%)", "Z Utilization (%)", "Color Utilization (%)", "GPU Memory Utilization (%)", "Level 3 Cache Utilization (%)", "Thread Dispatcher Utilization (%)", "Vertex Fetch Utilization (%)", "Clipper Utilization (%)", "Render Command Streamer Utilization (%)", "Compute Command Streamer Utilization (%)"] },
        "nvidia": { "confidence": "unverified", "patterns": ["GPU Busy*", "SM Active*", "ALU Pipe Activity*", "*Utilization*"] },
        "amd": { "confidence": "unverified", "patterns": ["GPUBusy*", "GPU Busy*", "*Utilization*", "*Busy*"] }
      }
    },
    "aluUtilization": {
      "description": "ALU issue utilization across all shader stages.",
      "vendors": {
        "intel": { "confidence": "transcribed", "patterns": ["XVE Utilization (%)", "XVE_INST_EXECUTED_ALU0_*_UTILIZATION", "XVE_INST_EXECUTED_ALU1_*_UTILIZATION", "XVE_INST_EXECUTED_ALU2_ALL", "XVE_PIPE_ALU0_AND_ALU1_ACTIVE"] },
        "nvidia": { "confidence": "unverified", "patterns": ["ALU Pipe Activity*", "FMA Pipe*", "*ALU*"] },
        "amd": { "confidence": "unverified", "patterns": ["VALUBusy*", "SALUBusy*", "VALUUtilization*"] }
      }
    },
    "perStageAlu": {
