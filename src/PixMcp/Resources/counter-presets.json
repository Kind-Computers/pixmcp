        "nvidia": { "confidence": "unverified", "patterns": ["*VS*Active*", "*PS*Active*", "*CS*Active*"] },
        "amd": { "confidence": "unverified", "patterns": ["VSBusy*", "PSBusy*", "CSBusy*", "HSBusy*", "DSBusy*", "GSBusy*"] }
      }
    },
    "occupancy": {
